{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowIAMForRDSMonitoring",
      "Effect": "Allow",
      "Action": [
        "iam:ListInstanceProfiles",
        "iam:ListRoles",
        "iam:GetRole",
        "iam:CreateRole",
        "iam:CreateInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:AttachRolePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowPassRoleForRDSMonitoringOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/rds-monitoring-role*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "monitoring.rds.amazonaws.com"
        }
      }
    }
  ]
}